{
  "name": "keybinds-redemptions",
  "productName": "Keybinds Redemptions",
  "version": "0.5.0",
  "description": "Aperta uma tecla no PC do streamer em resgates, bits, subs, gift subs e doações da live.",
  "author": "Thiago Arruda <tarruda1513@gmail.com>",
  "private": true,
  "main": "src/main/main.js",
  "twitchClientId": "zq9854i4gj8u5nb21dz8vsartoyj6k",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "2.16.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.asrus.keybinds-redemptions",
    "productName": "Keybinds Redemptions",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Asrus21",
        "repo": "keybinds-redemptions"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KeybindsRedemptions-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KeybindsRedemptions-Portable-${version}.${ext}"
    }
  }
}
